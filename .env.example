# Django uses safe local defaults when this file is not loaded.
# Set a long random value in production and never commit the real secret.
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave POSTGRES_HOST unset to use SQLite for local learning.
# Docker Compose supplies these values automatically.
POSTGRES_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=db
POSTGRES_PORT=5432
